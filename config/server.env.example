# 在你自己的云端秘密配置中填写；不是客户端配置，不上传真实值。
IMA_OPENAPI_CLIENTID=REPLACE_WITH_YOUR_IMA_CLIENT_ID
IMA_OPENAPI_APIKEY=REPLACE_WITH_YOUR_IMA_API_KEY
IMA_CLOUD_BRIDGE_TOKEN=REPLACE_WITH_A_STRONG_RANDOM_BRIDGE_TOKEN
# 独立32字节随机密钥的base64；原生会话使用AES-GCM加密。
IMA_SESSION_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_RANDOM_BYTES
# DB和BUCKET是D1/R2运行时绑定，不是JSON字符串环境变量。
