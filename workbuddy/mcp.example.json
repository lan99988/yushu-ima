{
  "mcpServers": {
    "yushu-ima": {
      "command": "python",
      "args": [
        "/ABSOLUTE/PATH/yushu-ima/agent/ima_agent.py",
        "stdio"
      ],
      "env": {
        "IMA_MCP_URL": "https://YOUR_AUTHORIZED_SITE/bridge/v1/mcp",
        "IMA_CLOUD_SERVICE_TOKEN": "REPLACE_LOCALLY",
        "IMA_CLOUD_BRIDGE_TOKEN": "REPLACE_LOCALLY",
        "IMA_CLOUD_TIMEOUT": "120"
      }
    }
  }
}
